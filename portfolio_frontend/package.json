{
  "name": "portfolio-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:port": "sh -c 'PORT=${NEXT_PUBLIC_PORT:-3000} next dev -p $PORT'",
    "dev:3001": "next dev -p 3001",
    "build": "next build",
    "start": "sh -c 'PORT=${NEXT_PUBLIC_PORT:-3000} next start -p $PORT'",
    "lint": "next lint"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "next": "14.2.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.4",
    "autoprefixer": "10.4.18",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "8.4.33",
    "tailwindcss": "3.4.3"
  }
}
